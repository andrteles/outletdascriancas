# Copie para .env (nunca commitar o .env de verdade — já está no .gitignore)
# Estas mesmas variáveis também precisam ser configuradas no Lovable
# (Project Settings > Environment Variables) para o site publicado funcionar.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Checkout Zedy (https://app.zedy.com.br/docs) — token e Store ID vêm do painel da Zedy.
ZEDY_API_TOKEN=
ZEDY_STORE_ID=
# Gerado pela Zedy ao cadastrar a URL do webhook (https://SEU_DOMINIO/api/webhooks/zedy)
# no painel dela — só existe depois do deploy, a Zedy não alcança localhost.
ZEDY_WEBHOOK_SECRET=
