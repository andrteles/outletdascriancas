# Banco de rastreamento (pixel_settings, zedy_webhook_events) — é o projeto Supabase
# da própria loja, não o do Lovable Cloud. URL e chave service_role vêm em
# Supabase → Project Settings → API.
TRACKING_SUPABASE_URL=
TRACKING_SUPABASE_SERVICE_ROLE_KEY=

# Checkout Zedy (https://app.zedy.com.br/docs) — token e Store ID vêm do painel da Zedy.
# Já estão salvos nos Secrets do projeto; estes campos ficam só como referência.
ZEDY_API_TOKEN=
ZEDY_STORE_ID=
# Gerado pela Zedy ao cadastrar a URL do webhook (https://SEU_DOMINIO/api/webhooks/zedy)
# no painel dela — só existe depois do deploy, a Zedy não alcança localhost.
ZEDY_WEBHOOK_SECRET=
